{
  "name": "selfcloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node --watch server.js\" \"vite --host 0.0.0.0\"",
